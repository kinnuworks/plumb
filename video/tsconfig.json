{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "jsx": "react-jsx",
  "strict": true,
  "skipLibCheck": true,
  "esModuleInterop": true,
  "noEmit": true,
  "resolveJsonModule": true,
